# Server-only settings. Do not commit filled files or copy them into Actions.
GCHAT_SHARED_DIR=/opt/gchat/shared
GCHAT_DOMAIN=chat.example.com
GCHAT_HTTP_PORT=3000
GCHAT_READY_TIMEOUT=120
# Set to `id -g gchat-deploy`; turnserver.conf should be owned by that group, mode 640.
GCHAT_CONFIG_GID=65534
POSTGRES_DB=gchat
POSTGRES_USER=gchat
POSTGRES_PASSWORD=
REDIS_PASSWORD=
