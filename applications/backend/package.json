{
  "name": "@gchat/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GChat backend built with NestJS",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "db:up": "docker compose --env-file .env -f docker-compose.yml up -d --wait",
    "db:down": "docker compose --env-file .env -f docker-compose.yml down",
    "db:logs": "docker compose --env-file .env -f docker-compose.yml logs -f postgres redis",
    "db:ps": "docker compose --env-file .env -f docker-compose.yml ps",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env dist/database/migrate.js",
    "admin:create": "node --env-file-if-exists=.env dist/auth/admin-cli.js",
    "openapi:export": "node dist/swagger/export-openapi.js",
    "openapi:test": "pnpm build && node --test test/openapi-build.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/platform-ws": "12.3.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/websockets": "12.3.2",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "^3.6.7",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
