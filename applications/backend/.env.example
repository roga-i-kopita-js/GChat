# Local development only. Copy to .env before starting PostgreSQL and Redis.
HOST=127.0.0.1
PORT=3000
LOG_REDACTION_ENABLED=true
# Optional: enable server Web delivery after build:server. The Docker image sets /app/web.
# GCHAT_WEB_ROOT=/absolute/path/to/applications/web/dist

POSTGRES_DB=gchat
POSTGRES_USER=gchat
POSTGRES_PASSWORD=gchat_local_only
POSTGRES_PORT=5433

# Used by the backend running on the host. Keep in sync with POSTGRES_* above.
DATABASE_URL=postgresql://gchat:gchat_local_only@127.0.0.1:5433/gchat

# Local Redis container. Keep REDIS_URL in sync; URL-encode special password characters.
REDIS_PASSWORD=gchat_redis_local_only
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# RedisModule connection settings for the backend running on the host.
REDIS_URL=redis://:gchat_redis_local_only@127.0.0.1:6379/0
REDIS_KEY_PREFIX=gchat:local:
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_STARTUP_TIMEOUT_MS=10000

# RedlockModule lease settings (not a separate container).
REDLOCK_LEASE_MS=10000
REDLOCK_ACQUIRE_TIMEOUT_MS=2000
REDLOCK_RETRY_DELAY_MS=100
REDLOCK_RETRY_JITTER_MS=100
REDLOCK_EXTEND_THRESHOLD_MS=3000
REDLOCK_MAX_HOLD_MS=30000

# Auth: generate environment-specific keys as described in README. No default secrets.
# Independent password pepper: 32 random bytes in base64; keep outside the database.
AUTH_PASSWORD_PEPPER=
# Access JWT lifetime in seconds; sessions remain valid until revoked.
AUTH_ACCESS_TOKEN_TTL_SECONDS=120
AUTH_JWT_ACTIVE_KID=local-1
AUTH_JWT_PRIVATE_KEY=
# JSON object: {"local-1":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}
AUTH_JWT_PUBLIC_KEYS=
AUTH_ROTATION_ACTIVE_KID=local-1
# JSON object: {"local-1":"<32 random bytes in base64>"}
AUTH_ROTATION_KEYS=
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_MS=300000
AUTH_REFRESH_MAX_OPERATIONS=10
AUTH_REFRESH_WINDOW_MS=60000

# DirectCalls: temporary credentials for the separate GChat coturn. No default secret.
DIRECT_CALLS_TURN_URLS=["turn:localhost:3478?transport=udp","turn:localhost:3478?transport=tcp"]
DIRECT_CALLS_TURN_SHARED_SECRET=
DIRECT_CALLS_RINGING_TIMEOUT_SECONDS=60
DIRECT_CALLS_CONNECTING_TIMEOUT_SECONDS=30
DIRECT_CALLS_RECONNECT_TIMEOUT_SECONDS=30
DIRECT_CALLS_HEARTBEAT_TIMEOUT_SECONDS=30

# APNs credentials for the iOS GChat application, kept outside the repository.
APNS_ENABLED=true
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_FILE=
APNS_BUNDLE_ID=
APNS_ENVIRONMENT=sandbox

# Exact origins allowed to obtain/redeem browser WebSocket tickets.
SIGNALING_BROWSER_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
