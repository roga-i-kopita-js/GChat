{
  "name": "@gchat/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write --ignore-unknown --ignore-path .gitignore --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-unknown --ignore-path .gitignore --ignore-path ../../.prettierignore .",
    "style:check": "oxlint --config ../../.oxlintrc.json --deny-warnings .",
    "style:fix": "oxlint --config ../../.oxlintrc.json --fix --deny-warnings .",
    "lint": "pnpm style:check && pnpm format:check",
    "lint:fix": "pnpm format && pnpm style:fix && pnpm format"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.3",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
