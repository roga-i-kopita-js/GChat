<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key><string>GChat Audio Test</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>GChatHarnessServer</key><string>$(GCHAT_HARNESS_SERVER)</string>
    <key>GChatHarnessLogin</key><string>$(GCHAT_HARNESS_LOGIN)</string>
    <key>GChatHarnessPeerID</key><string>$(GCHAT_HARNESS_PEER_ID)</string>
    <key>NSCameraUsageDescription</key><string>GChat проверяет камеру и PiP во время тестового звонка по вашему действию.</string>
    <key>NSMicrophoneUsageDescription</key><string>Аудиостенд GChat проверяет голосовой звонок по вашему действию.</string>
    <key>NSLocalNetworkUsageDescription</key><string>Аудиостенд подключается к тестовому backend и TURN на вашем Mac в локальной сети.</string>
    <key>UIBackgroundModes</key><array><string>audio</string><string>voip</string></array>
    <key>UILaunchScreen</key><dict/>
    <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
</dict></plist>
