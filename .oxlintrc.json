{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": ["@stylistic/eslint-plugin", "eslint-plugin-simple-import-sort"],
  "ignorePatterns": ["**/dist/**", ".pnpm-store/**"],
  "rules": {
    "@stylistic/lines-between-class-members": [
      "error",
      {
        "enforce": [
          {
            "blankLine": "always",
            "prev": "*",
            "next": "method"
          },
          {
            "blankLine": "always",
            "prev": "method",
            "next": "*"
          }
        ]
      }
    ],
    "@stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": "*",
        "next": "class"
      },
      {
        "blankLine": "always",
        "prev": "class",
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": "export"
      },
      {
        "blankLine": "always",
        "prev": "export",
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": ["const", "let", "var"],
        "next": "*"
      },
      {
        "blankLine": "any",
        "prev": ["const", "let", "var"],
        "next": ["const", "let", "var"]
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": ["return", "throw", "if", "switch", "for", "while", "do", "try"]
      },
      {
        "blankLine": "always",
        "prev": ["if", "switch", "for", "while", "do", "try"],
        "next": "*"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "simple-import-sort/imports": "error"
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
      "rules": {
        "typescript/explicit-function-return-type": [
          "error",
          {
            "allowExpressions": false,
            "allowTypedFunctionExpressions": false,
            "allowHigherOrderFunctions": false,
            "allowDirectConstAssertionInArrowFunctions": false,
            "allowConciseArrowFunctionExpressionsStartingWithVoid": false,
            "allowIIFEs": false
          }
        ]
      }
    },
    {
      "files": ["**/*.spec.ts", "**/*.test.ts", "**/test/**", "**/tests/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/consistent-type-assertions": "off"
      }
    }
  ]
}
